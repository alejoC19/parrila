---
import SectionHead from './SectionHead.astro';
import { site } from '../lib/site';
const { ubicacion, hours, location, contact } = site;
const embed = `https://maps.google.com/maps?q=${location.lat},${location.lng}&z=16&hl=es&output=embed`;
const dayName = (d: number) => ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'][d];
---

<section id="donde" class="mx-auto max-w-[1500px] px-4 py-20 md:px-8 md:py-32" aria-labelledby="donde-title">
  <SectionHead number={ubicacion.number} label={ubicacion.label} />
  <div class="mt-10 grid gap-10 md:mt-16 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-5">
      <h2 id="donde-title" class="display text-[clamp(2.8rem,6.4vw,6rem)]" data-up>{ubicacion.title}</h2>

      <address class="mt-8 text-xl leading-snug not-italic" data-up>
        <strong class="font-bold">{location.street}</strong><br />
        {location.city}, {location.region}
      </address>

      <div class="mt-8" data-up>
        <h3 class="text-[0.7rem] font-bold tracking-[0.18em] text-mute uppercase">Horarios</h3>
        <ul class="mt-2">
          {
            hours.schedule.map((s) => (
              <li class="rule flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
                <span class="font-semibold">{s.label}</span>
                <span class="display text-2xl">{s.slots.map(([a, b]) => `${a} a ${b === '24:00' ? '00:00' : b}`).join('  ·  ')}</span>
              </li>
            ))
          }
          <li class="rule"></li>
        </ul>
        <p class="mt-3 text-xs text-mute">{hours.note}</p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3" data-up>
        <a class="btn" href={location.mapsLink} target="_blank" rel="noopener">{ubicacion.directions}<span aria-hidden="true">↗</span></a>
        <a class="btn btn-ghost" href={`tel:${contact.phoneHref}`}>Llamar</a>
      </div>
    </div>

    <div class="md:col-span-7">
      <div class="frame aspect-[4/3] border-2 border-ink md:aspect-auto md:h-full md:min-h-[480px]" data-reveal>
        <a href={location.mapsLink} target="_blank" rel="noopener" class="link absolute inset-0 grid place-items-center text-sm font-bold tracking-widest uppercase">Abrir el mapa en Google Maps ↗</a>
        <iframe
          title={`Mapa de ${site.brand.name}, ${location.street}`}
          src={embed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="absolute inset-0 h-full w-full border-0 grayscale-[0.85] contrast-[1.05] sepia-[0.25]"
        ></iframe>
      </div>
    </div>
  </div>
</section>
