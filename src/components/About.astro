---
import Pic from './Pic.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../lib/site';
const { about, stats, demo } = site;
---

<section id="historia" class="mx-auto max-w-[1500px] px-4 py-20 md:px-8 md:py-32" aria-labelledby="historia-title">
  <SectionHead number={about.number} label={about.label} />

  <div class="mt-10 grid gap-10 md:mt-16 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-7">
      <h2 id="historia-title" class="display text-[clamp(2.8rem,7.4vw,7rem)]" data-up>
        {about.statement}
      </h2>

      <div class="mt-10 grid gap-5 text-lg leading-relaxed md:mt-14 md:max-w-[62ch] md:grid-cols-2 md:gap-8 md:text-[1.05rem]" data-up>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      {demo.enabled && <p class="mt-6 max-w-[62ch] border-l-4 border-brasa pl-3 text-sm text-mute">{about.pending}</p>}
    </div>

    <div class="md:col-span-5 md:pt-24">
      <div class="frame frame-px aspect-[4/5]" data-reveal>
        <Pic name={about.image} alt={about.imageAlt} sizes="(min-width: 768px) 38vw, 100vw" widths={[480, 800, 1100]} position="40% center" />
      </div>
    </div>
  </div>

  <dl class="rule mt-16 grid divide-y divide-ink/30 md:mt-24 md:grid-cols-3 md:divide-x md:divide-y-0">
    {
      stats.map((s) => (
        <div class="py-6 md:px-6 md:first:pl-0" data-up>
          <dt class="display text-[clamp(3.4rem,7vw,6.5rem)] text-brasa">{s.value}</dt>
          <dd class="mt-2 text-sm font-semibold tracking-wide uppercase">{s.label}</dd>
        </div>
      ))
    }
  </dl>
</section>
