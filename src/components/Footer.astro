---
import { site } from '../lib/site';
const { brand, contact, location, footer, demo } = site;
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-[1500px] px-4 pt-16 pb-28 md:px-8 md:pt-24 md:pb-10">
    <p class="display text-[clamp(3.6rem,19.6vw,20rem)] leading-[0.82] select-none" aria-hidden="true">{brand.wordmark}</p>

    <div class="mt-12 grid gap-8 border-t border-paper/40 pt-6 text-sm md:grid-cols-4">
      <div>
        <h2 class="text-[0.7rem] font-bold tracking-[0.18em] uppercase opacity-60">Instagram</h2>
        <a class="link mt-1 inline-block text-lg font-semibold" href={contact.instagram} target="_blank" rel="noopener">{contact.instagramHandle}</a>
      </div>
      <div>
        <h2 class="text-[0.7rem] font-bold tracking-[0.18em] uppercase opacity-60">Teléfono</h2>
        <a class="link mt-1 inline-block text-lg font-semibold" href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
      </div>
      <div>
        <h2 class="text-[0.7rem] font-bold tracking-[0.18em] uppercase opacity-60">Dirección</h2>
        <p class="mt-1 text-lg font-semibold">{location.street}<br />{location.city}</p>
      </div>
      <div>
        <h2 class="text-[0.7rem] font-bold tracking-[0.18em] uppercase opacity-60">Carta</h2>
        <a class="link mt-1 inline-block text-lg font-semibold" href="/carta">Ver la carta →</a>
      </div>
    </div>

    <p class="mt-10 flex flex-wrap justify-between gap-2 text-xs opacity-70">
      <span>{footer.tagline}</span>
      <span>© {new Date().getFullYear()} {brand.name}{demo.enabled ? ` · ${footer.credit}` : ''}</span>
    </p>
  </div>
</footer>
