---
import Base from '../layouts/Base.astro';
import { site, absUrl, waLink, restaurantJsonLd } from '../lib/site';
import { getImage } from 'astro:assets';
import { img } from '../lib/images';
import fallback from '../data/menu.fallback.json';
import { buildMenu, renderMenu, renderTabs } from '../lib/menu';

const { carta, brand, demo } = site;
const cats = buildMenu(fallback.items);
const og = await getImage({ src: img(site.meta.ogImage), width: 1200, height: 630, format: 'jpg', quality: 80 });

const menuLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Carta de ${brand.name}`,
  url: absUrl('/carta'),
  inLanguage: 'es-AR',
  hasMenuSection: cats.map((c) => ({
    '@type': 'MenuSection',
    name: c.name,
    hasMenuItem: c.items.map((i) => ({
      '@type': 'MenuItem',
      name: i.nombre,
      ...(i.descripcion ? { description: i.descripcion } : {}),
      ...(i.precio != null ? { offers: { '@type': 'Offer', price: i.precio, priceCurrency: 'ARS' } } : {}),
      ...(i.tags.includes('vegetariano') ? { suitableForDiet: 'https://schema.org/VegetarianDiet' } : {}),
      ...(i.tags.includes('sin-tacc') ? { suitableForDiet: 'https://schema.org/GlutenFreeDiet' } : {}),
    })),
  })),
};

const updated = new Date(fallback.updated + 'T12:00:00').toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
const cfg = JSON.stringify({ csv: carta.sheetCsvUrl, empty: carta.emptyText });
---

<Base
  title={`Carta · ${brand.name}`}
  description={`La carta de ${brand.name}: asador, entradas, guarniciones, postres y bebidas. Platos y precios al día.`}
  path="/carta"
  jsonLd={[restaurantJsonLd(absUrl(og.src)), menuLd]}
  bodyClass="carta"
>
  <header class="border-b border-ink/30">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3">
      <a href="/" class="display text-[1.6rem] leading-none" aria-label={`${brand.name}, inicio`}>{brand.wordmark}</a>
      <a href={waLink()} class="btn !px-3 !py-2 text-xs" target="_blank" rel="noopener">Reservar</a>
    </div>
  </header>

  <main class="mx-auto max-w-3xl" data-carta={cfg}>
    <div class="px-4 pt-8 pb-5">
      <h1 class="display text-[clamp(4rem,19vw,7.5rem)]">{carta.title}</h1>
      <p class="mt-3 text-base text-mute">{carta.intro}</p>

      <label class="mt-6 block">
        <span class="sr-only">Buscar en la carta</span>
        <input
          id="q"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder={carta.searchPlaceholder}
          class="w-full border-2 border-ink bg-paper px-4 py-3.5 text-base placeholder:text-mute/80 focus:outline-none focus-visible:border-brasa focus-visible:ring-2 focus-visible:ring-brasa"
        />
      </label>

      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filtrar por etiqueta">
        {carta.tags.map((t) => <button type="button" class="chip" data-chip={t.id} aria-pressed="false">{t.label}</button>)}
      </div>
    </div>

    <nav id="tabs-wrap" class="sticky top-0 z-40 border-y-2 border-ink bg-paper" aria-label="Categorías">
      <div id="tabs" class="flex overflow-x-auto px-2" set:html={renderTabs(cats)} />
    </nav>

    <div id="menu" class="px-4 pb-16" set:html={renderMenu(cats)} />

    <p id="empty" class="hidden px-4 pb-16 text-lg" role="status">{carta.emptyText}</p>

    <footer class="border-t border-ink/30 px-4 py-6 text-sm text-mute">
      <p id="status" role="status" aria-live="polite">Precios al {updated}.</p>
      <p class="mt-1">{carta.footnote}</p>
      {demo.enabled && <p class="mt-1">{demo.text}.</p>}
    </footer>
  </main>

  <script>
    import '../scripts/carta';
  </script>
</Base>

<style is:global>
  body.carta::after {
    opacity: 0.06;
  }
  .chip {
    border: 2px solid var(--color-ink);
    padding: 0.45rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: transparent;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .chip[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  #tabs {
    scrollbar-width: none;
  }
  #tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    flex: none;
    padding: 0.95rem 0.85rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1;
    border-bottom: 4px solid transparent;
    color: var(--color-mute);
    scroll-snap-align: center;
  }
  .tab[aria-current='true'] {
    color: var(--color-ink);
    border-bottom-color: var(--color-brasa);
  }
  .tab[hidden] {
    display: none;
  }
  .cat {
    scroll-margin-top: 4.2rem;
    padding-top: 2.2rem;
  }
  .cat[hidden],
  .item[hidden] {
    display: none;
  }
  .cat-title {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 11vw, 3.8rem);
    line-height: 0.9;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--color-ink);
  }
  .cat-n {
    font-size: 1.3rem;
    color: var(--color-brasa);
  }
  .item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  .item-name {
    font-weight: 700;
    font-size: 1.08rem;
    line-height: 1.25;
  }
  .item-desc {
    margin-top: 0.15rem;
    color: var(--color-mute);
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .item-price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1.1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }
  .tag {
    border: 1.5px solid var(--color-ink);
    padding: 0.1rem 0.4rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tag-recomendado {
    background: var(--color-brasa);
    border-color: var(--color-brasa);
    color: var(--color-paper);
  }
  .tag-picante {
    color: var(--color-brasa);
    border-color: var(--color-brasa);
  }
</style>
